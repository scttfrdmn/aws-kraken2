# Run-harness settings, sourced by scripts/run.sh, orphans.sh and report.sh. See docs/run.md.
AWS_PROFILE="${AWS_PROFILE:-aws}"
AK2_ACCOUNT=942542972736
# Regions this repo launches into; `make orphans` sweeps all of them. us-west-1 is listed
# because spawn has placed runs there unasked before (cookbook lith-kraken2-roda).
AK2_REGIONS="us-west-2 us-east-1 us-west-1"
# Results bucket per run region (must be in the run's region). Reuses the cookbook's
# COOKBOOK_BUCKET under the aws-kraken2/ prefix rather than creating a new bucket.
AK2_RESULTS_BUCKET_us_west_2=cookbook-942542972736-us-west-2
AK2_RESULTS_ROOT=aws-kraken2
# Instance tags run.sh adds at launch, and the task_id prefix spawn tags as spawn:task-id.
AK2_TAG_PROJECT=aws-kraken2
AK2_TASK_PREFIX=ak2-
