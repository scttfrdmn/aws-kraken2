# Run-harness settings, sourced by scripts/run.sh, orphans.sh and report.sh. See docs/run.md.
AWS_PROFILE="${AWS_PROFILE:-aws}"
AK2_ACCOUNT=942542972736
# `make orphans` sweeps every region enabled in the account (ec2 describe-regions), not a
# fixed list: spawn has placed runs in an unasked-for region before (cookbook lith-kraken2-roda).
# Results bucket per run region (must be in the run's region). A dedicated project bucket
# (Scott, 2026-10-07), because multi-node runs need spawn's bucket-wide s3_read_write grant:
# versioning on, AbortIncompleteMultipartUpload after 7 days, noncurrent versions expire after 30.
AK2_RESULTS_BUCKET_us_west_2=aws-kraken2-942542972736-us-west-2
AK2_RESULTS_ROOT=aws-kraken2
# Instance tags run.sh adds at launch, and the task_id prefix spawn tags as spawn:task-id.
AK2_TAG_PROJECT=aws-kraken2
AK2_TASK_PREFIX=ak2-
# Ceilings on any one spec: run.sh refuses a lifecycle.ttl or cost_limit above these. Setting
# them is Scott's call. Scott, 2026-10-06: $5 per run is a guide, not a cap ("perform the tests
# you need"). Scott, 2026-10-09 (#25): cost is something the experiment measures, so there is
# no budget envelope or hard spend cap; spend is tracked (manifest cost_usd,
# results/g3/campaign/spend.tsv). Each run's TTL and cost_limit (TTL x on-demand price) remain as
# runaway backstops. AK2_MAX_COST_USD is therefore only a sanity ceiling against typos, applied
# to a spec's cost_limit (run.sh) and to NODES x cost_limit (run-multi.sh); it is not a budget.
AK2_MAX_TTL_S=28800
AK2_MAX_COST_USD=500
# EC2 caps user data at 16384 bytes after base64 decoding; run.sh refuses a spec whose
# spawn-built user data (measured by scripts/udsize) comes within this many bytes of it.
AK2_USERDATA_MARGIN=${AK2_USERDATA_MARGIN:-1024}
