IF=""; CG=""; T=""
ak2u_now() { if [ -n "${EPOCHREALTIME:-}" ]; then T=${EPOCHREALTIME%???}; T=${T/,/.}; else T=$(date +%s); fi; }
ak2u_iface() {
  local i d r
  while read -r i d r; do [ "$d" = 00000000 ] && { IF=$i; return 0; }; done < /proc/net/route
  return 1
}
ak2u_cgroup() {
  local l
